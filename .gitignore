# Lokale containerconfiguratie, zonder geheimen: moet wel mee de repo in,
# anders kan het startscript geen .env aanmaken.
!.env.docker

# Deploy-werkbestanden op de VPS: het slot dat twee gelijktijdige deploys
# tegenhoudt, en de UI-momentopnames waaruit een mislukte deploy terugzet.
.deploy.lock
apps/api/.deploy/

# Aangeleverde prijslijsten van de leverancier. De werkbladen zelf blijven
# buiten de repo — ze zijn groot en de leverancier merkt ze aan als
# vertrouwelijk. Wat er wél in gaat is de uitdraai onder
# apps/api/database/data/pricelists/, gemaakt met scripts/pricelist/.
/*.xlsx

# Persoonlijke Claude Code-instellingen voor deze checkout. Blijft lokaal:
# permissieregels zijn een keuze van de gebruiker, niet van het project.
.claude/settings.local.json

# Local tooling
.venv/
.docker/
.DS_Store
.idea/

# OS / editor noise
*.swp
*~

# Losse werkkopie van de tweede landingspagina (eigen git-repo). De versie die
# meegaat naar productie staat in apps/web/public/v2/.
/aircov2/
