# De statische Nuxt-build wordt op de VPS in public/ gepubliceerd, naast de
# front controller. Alleen wat Laravel zelf meebrengt hoort in git; de rest
# (_nuxt/, media/, v2/, de gegenereerde HTML) is een bouwresultaat.
/public/*
!/public/index.php
!/public/.htaccess
!/public/favicon.ico

/storage/*.key
/storage/pail
/vendor
Homestead.json
Homestead.yaml
Thumbs.db

# Losse sqlite-bestanden buiten database/ (bijvoorbeeld door een verkeerd
# ingevulde DB_DATABASE) horen nooit in de repository.
/klimaatx
*.sqlite
*.sqlite-journal
