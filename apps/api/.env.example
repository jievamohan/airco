APP_NAME=KlimaatX
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://airco.sinoxi.nl
APP_TIMEZONE=Europe/Amsterdam

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=klimaatx
DB_USERNAME=klimaatx
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Origins die de API mogen aanroepen (komma-gescheiden). Op productie draaien
# de site en de API op hetzelfde domein, dus stuurt de browser geen
# cross-origin-verzoeken en doet deze lijst niets. Hij staat er voor het geval
# de site later een eigen domein krijgt.
DASHBOARD_ORIGINS=https://airco.sinoxi.nl

# --- Uitgaande mail ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="offertes@klimaatx.nl"
MAIL_FROM_NAME="${APP_NAME}"

# --- Bedrijfsgegevens ---
COMPANY_NAME=KlimaatX
COMPANY_EMAIL=info@klimaatx.nl
COMPANY_PHONE=+31201234567
COMPANY_WEBSITE=https://klimaatx.nl
COMPANY_POSTCODE=
COMPANY_CITY=
COMPANY_KVK=
COMPANY_VAT_NUMBER=

# --- Notificaties naar de ondernemer ---
OWNER_NOTIFICATION_EMAIL=info@klimaatx.nl
OWNER_NAME=KlimaatX

# --- Dashboardsessies ---
AUTH_SESSION_LIFETIME_MINUTES=480
AUTH_REMEMBER_LIFETIME_DAYS=30

# --- Agent-modus ---
# true = volledige workflow loopt, maar er wordt niet echt gebeld/gemaild/geboekt
AGENT_DRY_RUN=false

# --- Mailbox-intake (IMAP) ---
MAILBOX_ENABLED=false
MAILBOX_HOST=
MAILBOX_PORT=993
MAILBOX_ENCRYPTION=ssl
MAILBOX_VALIDATE_CERT=true
MAILBOX_USERNAME=
MAILBOX_PASSWORD=
MAILBOX_FOLDER=INBOX
MAILBOX_PROCESSED_FOLDER=INBOX.Verwerkt
MAILBOX_MAX_PER_RUN=25

# --- ElevenLabs Conversational AI ---
ELEVENLABS_ENABLED=false
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_WEBHOOK_TOLERANCE=1800

# --- Agenda: google | apple | none ---
CALENDAR_PROVIDER=none
CALENDAR_TIMEZONE=Europe/Amsterdam
CALENDAR_LEAD_TIME_HOURS=48
CALENDAR_HORIZON_DAYS=21
CALENDAR_WORKDAY_START=08:00
CALENDAR_WORKDAY_END=17:00
CALENDAR_TRAVEL_BUFFER_MINUTES=30

GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

APPLE_CALDAV_URL=https://caldav.icloud.com
APPLE_CALDAV_USERNAME=
APPLE_CALDAV_APP_PASSWORD=
APPLE_CALDAV_CALENDAR_PATH=

# --- Workflow-timing ---
FIRST_CALL_DELAY_MINUTES=3
CONVERSION_CALL_DELAY_MINUTES=60
MAX_CALL_ATTEMPTS=4
QUOTE_VALID_DAYS=21

# --- Prijsstelling (startwaarden; definitief instelbaar via het dashboard) ---
PRICING_VAT_RATE=21
PRICING_LABOUR_RATE_CENTS=7500
PRICING_CREW_SIZE=2
# Geadverteerde vanaf-prijs, inclusief btw. Geen offerte komt hieronder uit.
PRICING_ENTRY_PRICE_CENTS=89900
# Topt een eenvoudige instapklus af op de vanaf-prijs, ook onder de kostprijs.
# Elke offerte die daardoor onder de margedrempel zakt, wordt gemarkeerd.
PRICING_ENTRY_PACKAGE_ENABLED=false
PRICING_ENTRY_PACKAGE_MAX_KW=2.5
# Margebewaking
PRICING_MINIMUM_MARGIN_PCT=15
PRICING_LABOUR_COST_CENTS=6500
PRICING_DEFAULT_TIER=mid
PRICING_DIRECT_DISCOUNT_PCT=3
PRICING_DIRECT_DISCOUNT_MAX_CENTS=15000
PRICING_FREE_TRAVEL_KM=30
PRICING_TRAVEL_RATE_CENTS_PER_KM=55

QUOTE_PUBLIC_URL=https://airco.sinoxi.nl/offerte

# Startwachtwoord voor het eerste dashboardaccount, minimaal 12 tekens.
# Verplicht in te vullen: de seeder weigert een account aan te maken zolang dit
# leeg is, want een leeg wachtwoord verifieert gewoon en zet het dashboard open.
# Wijzig het direct na de eerste keer inloggen en haal deze regel daarna leeg.
OWNER_INITIAL_PASSWORD=
